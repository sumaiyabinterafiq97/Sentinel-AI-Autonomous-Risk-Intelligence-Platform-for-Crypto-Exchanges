# Sentinel AI — environment template (M0)
# Copy to .env locally. Never commit secrets.

# Shared
SENTINEL_ENV=local

# Backend (Spring Boot)
PLATFORM_PORT=8080
IDENTITY_PORT=8081
OPS_PORT=8082
DASH_PORT=8083
DASH_IDENTITY_BASE_URL=
DASH_OPS_BASE_URL=
DASH_AI_BASE_URL=
DASH_PLATFORM_BASE_URL=

# Platform → identity (M10 ADMIN provision orchestration)
IDENTITY_BASE_URL=

# AI service (FastAPI) — M8 assistive-only APIs (no domain lifecycle mutation)
AI_SERVICE_PORT=8090
IDENTITY_TOKEN_HMAC_KEY=local-m2-simulation-hmac-key-not-for-production

# Frontend
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8083

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-ai.internal/schemas/events/mvp/alert/AlertCreated.v1.schema.json",
  "title": "AlertCreatedPayload",
  "description": "Published by ALERT. ALERT owns alert lifecycle and priority.",
  "type": "object",
  "required": ["alertId", "status", "priority", "createdAt"],
  "properties": {
    "alertId": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["open", "triaged", "assigned"] },
    "priority": {
      "type": "integer",
      "description": "ALERT-owned queue priority — not overridden by RISK"
    },
    "riskAssessmentId": { "type": ["string", "null"], "format": "uuid" },
    "title": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
